# ─── Supabase ──────────────────────────────────────────────────────────
# These power the auth flow (signup → email confirmation → /auth/confirmed).
# Both must be set in production (Vercel → Project Settings → Environment Vars).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-PUBLISHABLE-ANON-KEY"

# ─── Site ──────────────────────────────────────────────────────────────
# Public origin used to build email confirmation redirect URLs.
# In production set to: https://www.cenalabs.com
NEXT_PUBLIC_SITE_URL="https://www.cenalabs.com"
